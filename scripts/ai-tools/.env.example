# Copy to .env if you prefer python-dotenv over a machine-level env var.
#
# Recommended instead: set this once as a user-level Windows env var on the
# dev workstation and skip this file entirely --
#   setx ANTHROPIC_API_KEY "sk-ant-..."
# -- keeps the key out of every file under the repo tree, matching this
# project's existing GDTF_SHARE_USER/PASSWORD and NordPass conventions
# (see docs/DESKTOP_DEV_SETUP.md and docs/r0/ACCOUNTS_AND_APIS.md).
#
# This file itself is committed as a placeholder only. The real .env is
# git-ignored -- never commit a key.
ANTHROPIC_API_KEY=
