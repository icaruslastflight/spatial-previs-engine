{
  "name": "spatial-previs-engine",
  "private": true,
  "version": "1.0.0-alpha",
  "type": "module",
  "description": "Spatial Previs Engine — venue-independent live event design and pre-visualization for real and virtual environments.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:r0:browser": "node scripts/test-r0-browser.mjs",
    "bridge": "node scripts/foh_bridge_daemon.js",
    "build:assets": "node scripts/build-asset-library.js",
    "fetch:gdtf": "node scripts/fetch_gdtf_library.js",
    "showcase:capture": "node scripts/capture_showcase.mjs",
    "verify": "scripts/workflows/verify_foundational_setup.sh"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "cesium": "^1.145.0",
    "express": "^4.22.3",
    "fast-xml-parser": "^4.5.7",
    "jszip": "^3.10.2",
    "three": "^0.186.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^26.5.1",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
