# Optional basemap keys. BOTH are optional -- the viewport runs keyless.
# Copy to .env.local (git-ignored via *.local) and fill in what you have.
# NEVER commit a real key.

# Google Maps Platform key for Photorealistic 3D Tiles.
# Highest-fidelity tier; matches the UE5 desktop basemap.
VITE_GOOGLE_MAPS_API_KEY=

